{
  "name": "@runloop/reflex-ui",
  "version": "0.1.0",
  "description": "Importable Reflex chat components for React, built from the same templates @runloop/reflex-chat-kit copies into your app.",
  "license": "MIT",
  "keywords": ["reflex", "runloop", "agents", "react", "chat", "components"],
  "homepage": "https://github.com/runloopai/reflex-os/tree/main/sdk/ui#readme",
  "bugs": "https://github.com/runloopai/reflex-os/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runloopai/reflex-os.git",
    "directory": "sdk/ui"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@reflex/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "sync:check": "node scripts/sync-registry.mjs --check",
    "build": "node scripts/sync-registry.mjs --check && tsc -p tsconfig.build.json && node scripts/fix-dist-extensions.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write --log-level warn --ignore-unknown 'src/**' 'scripts/**' '*.md'",
    "format:check": "prettier --check --log-level warn --ignore-unknown 'src/**' 'scripts/**' '*.md'"
  },
  "dependencies": {
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "peerDependencies": {
    "@runloop/reflex-client": "workspace:^",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@runloop/reflex-client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
