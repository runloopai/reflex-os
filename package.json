{
  "name": "reflex-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "postinstall": "pnpm client:generate",
    "client:generate": "orval --config orval.config.ts --project reflexSdk reflex",
    "build": "pnpm --recursive --filter './sdk/*' build",
    "test": "pnpm --recursive --filter './sdk/*' test",
    "typecheck": "pnpm --recursive --filter './sdk/*' typecheck",
    "lint:packages": "pnpm --recursive --filter './sdk/*' exec publint --strict",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint:packages"
  },
  "devDependencies": {
    "orval": "8.22.0",
    "publint": "^0.3.18"
  }
}
